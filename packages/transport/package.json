{
  "name": "@openlv/transport",
  "version": "0.0.3",
  "keywords": [
    "open-lavatory"
  ],
  "homepage": "https://github.com/v3xlabs/open-lavatory",
  "bugs": {
    "url": "https://github.com/v3xlabs/open-lavatory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v3xlabs/open-lavatory.git",
    "directory": "packages/transport"
  },
  "license": "LGPL-3.0-only",
  "author": {
    "name": "Open-Lavatory",
    "url": "https://github.com/v3xlabs/open-lavatory"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
