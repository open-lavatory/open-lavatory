  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@openlv/core": "workspace:*",
    "eventemitter3": "^5.0.1",
    "globals": "^16.2.0",
    "ts-pattern": "^5"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.0.8",
    "playwright": "1.60.0",
    "typescript": "^5",
    "vitest": "^4"
  },
  "packageManager": "pnpm@10.10.0",
  "publishConfig": {
    "access": "public"
  }
